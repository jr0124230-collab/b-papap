{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/$", "dest": "/api/page?page=index" },
    { "src": "/login(?:\\.html)?$", "dest": "/api/page?page=login" },
    { "src": "/index(?:\\.html)?$", "dest": "/api/page?page=index" },
    { "src": "/panel$", "dest": "/public/panel.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
