{
  "version": 2,
  "routes": [
    { "src": "/api/login",               "dest": "/api/login.js" },
    { "src": "/api/users",               "dest": "/api/users.js" },
    { "src": "/api/status/([^/]+)",      "dest": "/api/status/[id].js?id=$1" },
    { "src": "/api/apartment/([^/]+)",   "dest": "/api/apartment/[id].js?id=$1" },
    { "src": "/api/keyword/([^/]+)",     "dest": "/api/keyword/[id].js?id=$1" },
    { "src": "/(.*)",                    "dest": "/public/$1" }
  ]
}
